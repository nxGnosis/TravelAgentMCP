# ═══════════════════════════════════════════════════════════════
#  TravelAgentMCP — environment variables
#  Shared by the root gateway and every mcps/* server.
# ═══════════════════════════════════════════════════════════════

# ── TVA OTA backend (flights, hotels, bookings, account) ────────
# Base URL of the TVA OTA API (see postman/ in MegaMind for the full collection).
TVA_BASE_URL=http://localhost:8000

# Bearer token for the current end-user session. Never set this globally in a
# multi-tenant deployment — it must be injected per conversation session by
# whatever agent spawns these servers (see MegaMind/travel-agent's
# tva-session store). Left blank here; only useful for local single-user testing.
TVA_ACCESS_TOKEN=

TVA_API_TIMEOUT_MS=15000
TVA_MAX_RETRIES=2
TVA_RATE_LIMIT_MAX_CALLS=30
TVA_RATE_LIMIT_WINDOW_MS=60000

# Where flight-mcp persists cached Amadeus flight offers between tool calls
# (each MCP call is a fresh process, so this must be a durable file).
TVA_OFFER_CACHE_DB_PATH=

# ── Visa / Immigration content API (country requirements, fees, FAQs) ──
# A separate service from the TVA OTA backend above — used only by
# GET_VISA_INFO_BY_COUNTRY / GET_IMMIGRATION_INFO_BY_COUNTRY.
VISA_CONTENT_API_BASE_URL=https://agile-scrubland-71136-72b75abf9926.herokuapp.com/api/v1
VISA_CONTENT_API_KEY=
IMMIGRATION_CONTENT_API_BASE_URL=https://agile-scrubland-71136-72b75abf9926.herokuapp.com/api/v1
IMMIGRATION_CONTENT_API_KEY=

# ── Debug ─────────────────────────────────────────────────────
# Set to "true" to log redacted request/response summaries to stderr.
DEBUG_TVA_MCP=false
