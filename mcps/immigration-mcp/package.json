{
	"name": "@travelagent-mcp/immigration-mcp",
	"version": "1.0.0",
	"description": "MCP server for immigration service info and TVA OTA immigration booking tracking (updates, notifications, transactions).",
	"type": "module",
	"bin": {
		"tva-immigration-mcp": "dist/index.js"
	},
	"exports": {
		"./tools": "./dist/tools.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc && shx chmod +x dist/index.js",
		"watch": "tsc --watch",
		"start": "node dist/index.js",
		"format": "biome format . --write",
		"lint": "biome check ."
	},
	"dependencies": {
		"@travelagent-mcp/shared": "workspace:*",
		"dedent": "^1.6.0",
		"fastmcp": "^3.8.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.17.0",
		"shx": "^0.4.0",
		"typescript": "^5.8.3"
	}
}
