{
	"name": "travelagent-mcp",
	"version": "2.0.0",
	"description": "TVA OTA MCP server suite — flight, hotel, visa, immigration and account tools for AI travel agents. This package is the all-in-one gateway; see mcps/* for individually deployable domain servers.",
	"main": "src/index.ts",
	"type": "module",
	"bin": {
		"travelagent-mcp": "dist/index.js"
	},
	"files": ["dist"],
	"scripts": {
		"build": "pnpm -r --workspace-concurrency=1 build && tsc && shx chmod +x dist/index.js",
		"prepare": "husky",
		"watch": "tsc --watch",
		"start": "node dist/index.js",
		"publish-packages": "pnpm run build && changeset publish",
		"format": "biome format . --write",
		"lint": "biome check ."
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": "./src/index.ts",
			"require": "./src/index.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nxGnosis/travelagent-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/nxGnosis/travelagent-mcp/issues"
	},
	"homepage": "https://github.com/nxGnosis/travelagent-mcp#readme",
	"keywords": ["mcp", "travel", "flights", "hotels", "visa", "immigration", "amadeus"],
	"author": "Lanre Sanni",
	"license": "ISC",
	"packageManager": "pnpm@10.7.1",
	"dependencies": {
		"@travelagent-mcp/account-mcp": "workspace:*",
		"@travelagent-mcp/flight-mcp": "workspace:*",
		"@travelagent-mcp/hotel-mcp": "workspace:*",
		"@travelagent-mcp/immigration-mcp": "workspace:*",
		"@travelagent-mcp/shared": "workspace:*",
		"@travelagent-mcp/visa-mcp": "workspace:*",
		"dotenv": "^17.2.0",
		"fastmcp": "^3.8.4",
		"shx": "^0.4.0",
		"typescript": "^5.8.3"
	},
	"devDependencies": {
		"@biomejs/biome": "*",
		"@changesets/cli": "^2.29.5",
		"@types/node": "^22.17.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.0.0",
		"shx": "^0.4.0",
		"typescript": "^5.8.3"
	}
}
